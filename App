import os
import numpy as np
import pandas as pd
import streamlit as st

from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.metrics.pairwise import cosine_similarity


DATA_PATH = "sample_tickets.csv"


def ticket_text(row):
    return (
        f"Ticket ID: {row['ticket_id']}\n"
        f"Category: {row['category']}\n"
        f"Issue: {row['issue']}\n"
        f"Customer message: {row['customer_message']}\n"
        f"Resolution: {row['resolution']}"
    )


@st.cache_data
def load_tickets():
    df = pd.read_csv(DATA_PATH)
    df["full_text"] = df.apply(ticket_text, axis=1)
    return df


def retrieve_with_tfidf(df, query, k=3):
    corpus = df["full_text"].tolist() + [query]
    vectorizer = TfidfVectorizer(stop_words="english")
    mat = vectorizer.fit_transform(corpus)

    sims = cosine_similarity(mat[-1], mat[:-1]).flatten()
    top_idx = np.argsort(sims)[::-1][:k]
    return df.iloc[top_idx].copy(), sims[top_idx]


def retrieve_with_chroma_openai(df, query, k=3):
    import chromadb
    from openai import OpenAI

    client = OpenAI()
    chroma_client = chromadb.PersistentClient(path="./chroma_db")
    collection = chroma_client.get_or_create_collection("support_tickets")

    # Build index only once
    if collection.count() == 0:
        docs = df["full_text"].tolist()
        ids = df["ticket_id"].astype(str).tolist()

        emb = client.embeddings.create(
            model="text-embedding-3-small",
            input=docs
        )
        vectors = [item.embedding for item in emb.data]

        collection.add(
            ids=ids,
            documents=docs,
            embeddings=vectors,
            metadatas=df[["ticket_id", "category", "issue"]].to_dict("records")
        )

    q_emb = client.embeddings.create(
        model="text-embedding-3-small",
        input=[query]
    ).data[0].embedding

    results = collection.query(
        query_embeddings=[q_emb],
        n_results=k
    )

    ids = results["ids"][0]
    retrieved = df[df["ticket_id"].astype(str).isin(ids)].copy()
    return retrieved, results.get("distances", [[None] * len(ids)])[0]


def generate_draft(query, retrieved_df):
    context = "\n\n".join(retrieved_df["full_text"].tolist())

    if not os.getenv("OPENAI_API_KEY"):
        citations = ", ".join(retrieved_df["ticket_id"].astype(str).tolist())
        return (
            f"Hi,\n\nThanks for reaching out. Based on similar resolved tickets ({citations}), "
            f"the likely next step is to verify the account/order details, explain the relevant policy, "
            f"and provide a clear resolution path.\n\n"
            f"Your issue: {query}\n\n"
            f"Best,\nSupport Team"
        )

    from openai import OpenAI
    client = OpenAI()

    prompt = f"""
You are a customer support assistant.
Use only the similar resolved tickets below.
Write a polite draft response.
Add citations using ticket IDs in square brackets.

Customer query:
{query}

Similar resolved tickets:
{context}
"""

    response = client.responses.create(
        model="gpt-4.1-mini",
        input=prompt
    )
    return response.output_text


def main():
    st.title("Customer Support Resolution Engine")
    st.write("Retrieves similar resolved tickets and generates a citation-backed draft response.")

    df = load_tickets()

    query = st.text_area("Customer query", "I was charged twice and want my money back.")
    k = st.slider("Number of similar tickets", min_value=1, max_value=5, value=3)

    if st.button("Generate draft"):
        use_rag = os.getenv("OPENAI_API_KEY") is not None

        if use_rag:
            try:
                retrieved, scores = retrieve_with_chroma_openai(df, query, k)
                st.success("Using ChromaDB + OpenAI embeddings retrieval.")
            except Exception as e:
                st.warning(f"Falling back to TF-IDF retrieval because: {e}")
                retrieved, scores = retrieve_with_tfidf(df, query, k)
        else:
            retrieved, scores = retrieve_with_tfidf(df, query, k)
            st.info("Using local TF-IDF fallback. Add OPENAI_API_KEY for full RAG mode.")

        st.subheader("Retrieved similar tickets")
        for (_, row), score in zip(retrieved.iterrows(), scores):
            st.markdown(f"**{row['ticket_id']} — {row['issue']}**")
            st.write(row["resolution"])
            st.caption(f"Retrieval score/distance: {score}")

        st.subheader("Draft response")
        st.text_area("Generated draft", generate_draft(query, retrieved), height=260)


if __name__ == "__main__":
    main()
